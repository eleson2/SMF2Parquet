# Copy to .env and edit. .env is gitignored.

# --- Superset metadata DB (Postgres) ----------------------------------------
POSTGRES_USER=superset
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=superset

# --- Superset app -----------------------------------------------------------
# Generate: openssl rand -base64 42
SUPERSET_SECRET_KEY=change-me-to-a-long-random-string
SUPERSET_PORT=8088
# Public URL users hit (used to make links in emailed reports clickable).
SUPERSET_PUBLIC_URL=http://localhost:8088/

# Initial admin login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin
ADMIN_EMAIL=admin@example.com

# --- Data paths (host side) -------------------------------------------------
# The DuckDB marts file dbt builds (read-only mount). Absolute path recommended.
MARTS_DB_HOST_PATH=./dbt/marts.duckdb
# The SMF2Parquet output dir (read-only mount for raw drill-down in SQL Lab).
SMF_DATA_ROOT=./sample_out

# --- SMTP for scheduled email reports (Phase D) -----------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_USER=smf-reports@example.com
SMTP_PASSWORD=change-me-smtp
SMTP_MAIL_FROM=smf-reports@example.com
